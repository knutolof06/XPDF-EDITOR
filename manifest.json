{
  "manifest_version": 3,
  "name": "XPDF - Pro PDF Editor & Viewer",
  "version": "1.0.0",
  "description": "Gelişmiş, tamamen yerel (client-side) ve modern Chrome PDF Editörü ve Görüntüleyicisi",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "XPDF Editor Aç",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*", "pdfjs/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
